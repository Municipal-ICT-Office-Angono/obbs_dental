<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="obbs_dental.Dashboard">
        <div class="o_obbs_dashboard p-3" t-on-click="onRootClick"
             style="height: calc(100vh - 90px); overflow-y: auto;">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h4 class="m-0">
                    Oral Health Dashboard
                    <span t-if="state.data" class="text-muted fs-6 fw-normal ms-2"
                          t-esc="state.data.period_label"/>
                </h4>
                <div class="btn-group" role="group" aria-label="Period type">
                    <button type="button" class="btn" data-report-type="monthly"
                            t-att-class="state.reportType === 'monthly' ? 'btn-primary' : 'btn-secondary'">Monthly</button>
                    <button type="button" class="btn" data-report-type="quarterly"
                            t-att-class="state.reportType === 'quarterly' ? 'btn-primary' : 'btn-secondary'">Quarterly</button>
                    <button type="button" class="btn" data-report-type="annual"
                            t-att-class="state.reportType === 'annual' ? 'btn-primary' : 'btn-secondary'">Annual</button>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <select class="form-select w-auto" data-filter="year"
                        t-att-disabled="state.loading"
                        t-on-change="onFilterChange">
                    <option t-foreach="state.availableYears" t-as="y" t-key="y_index"
                            t-att-selected="isSelectedYear(y)"
                            t-esc="y"/>
                </select>
                <select t-if="state.reportType === 'monthly'"
                        class="form-select w-auto" data-filter="month"
                        t-att-disabled="state.loading"
                        t-on-change="onFilterChange">
                    <option t-foreach="MONTHS" t-as="m" t-key="m_index"
                            t-att-value="m[0]"
                            t-att-selected="isSelectedMonth(m)"
                            t-esc="m[1]"/>
                </select>
                <select t-if="state.reportType === 'quarterly'"
                        class="form-select w-auto" data-filter="quarter"
                        t-att-disabled="state.loading"
                        t-on-change="onFilterChange">
                    <option t-foreach="QUARTERS" t-as="q" t-key="q_index"
                            t-att-value="q[0]"
                            t-att-selected="isSelectedQuarter(q)"
                            t-esc="q[1]"/>
                </select>
                <input type="text" class="form-control w-auto" placeholder="Municipality"
                       data-filter="municipality"
                       t-att-disabled="state.loading" t-att-value="state.municipality"
                       t-on-change="onFilterChange"/>
                <input type="text" class="form-control w-auto" placeholder="Province"
                       data-filter="province"
                       t-att-disabled="state.loading" t-att-value="state.province"
                       t-on-change="onFilterChange"/>
                <button type="button" class="btn btn-primary" data-refresh="1"
                        t-att-disabled="state.loading"><i class="fa fa-refresh"/> Refresh</button>
            </div>

            <div t-if="state.loading" class="text-center p-5">
                <i class="fa fa-spinner fa-spin me-2"/>Loading dashboard…
            </div>
            <div t-elif="state.error" class="alert alert-danger m-0" t-esc="state.error"/>
            <t t-else="">
                <div class="row g-2 mb-3">
                    <div class="col-6 col-lg-2" t-foreach="kpiCards()" t-as="card" t-key="card.label">
                        <div class="card text-center shadow-sm"
                             style="cursor: pointer; user-select: none;"
                             t-att-data-drill="card.drillKey"
                             t-att-class="state.drillKey === card.drillKey ? 'border border-primary' : ''">
                            <div class="card-body py-3">
                                <div class="fs-4 fw-bold" t-esc="card.value"/>
                                <div class="text-muted small mt-1" t-esc="card.label"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Attended Patients by Age Group (Male / Female)</h5>
                        <div style="height: 340px;">
                            <canvas t-ref="chart" data-chart-canvas="1"></canvas>
                        </div>
                        <div class="text-muted small mt-2">
                            Click a bar to view the patients behind it.
                        </div>
                    </div>
                </div>

                <div t-if="state.drillKey" class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center py-2">
                        <span>Patients — <strong t-esc="drillLabel()"/></span>
                        <button type="button" class="btn btn-sm btn-link" data-close-drill="1">
                            Close
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Patient No.</th>
                                    <th>Name</th>
                                    <th>Sex</th>
                                    <th>Age</th>
                                    <th>Barangay</th>
                                    <th>Last Visit</th>
                                    <th class="text-end">Record</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="drillPatients()" t-as="p" t-key="p.id">
                                    <td t-esc="p.patient_number"/>
                                    <td t-esc="p.name"/>
                                    <td t-esc="sexLabel(p.sex)"/>
                                    <td t-esc="p.age"/>
                                    <td t-esc="p.barangay"/>
                                    <td t-esc="p.last_visit"/>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-link"
                                                t-att-data-open-patient="p.id">
                                            Open
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div t-if="drillPatients().length === 0"
                         class="p-3 text-muted">
                        No patients in this group for the selected period.
                    </div>
                </div>

                <h5 class="mt-4">Form-2 Indicators by Age Group</h5>
                <div class="card mb-2" t-foreach="state.data.sections" t-as="section" t-key="section.key">
                    <button type="button"
                            class="btn p-0 w-100 text-start border-0"
                            t-att-data-section="section.key">
                        <div class="card-header py-2 px-3 d-flex align-items-center
                                justify-content-between">
                            <span class="fw-semibold" t-esc="section.label"/>
                            <i class="fa"
                               t-att-class="state.openSection === section.key ? 'fa-chevron-up' : 'fa-chevron-down'"/>
                        </div>
                    </button>
                    <t t-if="state.openSection === section.key">
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0">
                                <thead>
                                    <tr>
                                        <th>Indicator</th>
                                        <th t-foreach="section.columns" t-as="c" t-key="c_index"
                                            class="text-end" t-esc="c"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="section.rows" t-as="row" t-key="row.key">
                                        <td t-esc="row.label"/>
                                        <td t-foreach="row.values" t-as="v" t-key="v_index"
                                            class="text-end" t-esc="v"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>
