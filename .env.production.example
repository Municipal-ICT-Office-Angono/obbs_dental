# ==============================================================================
# OBBS DENTAL - PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env or .env.production:
#      cp .env.production.example .env
# 2. In Dokploy, paste these variables into the "Environment" tab of your Compose app.
# 3. Replace all placeholder passwords with secure, randomly generated strings:
#      openssl rand -base64 24
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Database name for production data (distinct from obbs_dental_demo)
POSTGRES_DB=obbs_dental_prod

# Dedicated database user (avoid using default 'odoo' or 'postgres' in production)
POSTGRES_USER=obbs_db_admin

# Strong, unique database password (REQUIRED - generate with openssl or a password manager)
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_RANDOM_POSTGRES_PASSWORD_2026

# ------------------------------------------------------------------------------
# 2. Odoo Security & Application Settings
# ------------------------------------------------------------------------------
# Master Database Password (admin_passwd in odoo.conf)
# CRITICAL: This protects database creation, backups, and drops in Odoo.
# In Odoo 19 this cannot be set via CLI; our entrypoint injects it into odoo.conf.
ODOO_ADMIN_PASSWORD=CHANGE_ME_TO_A_SECURE_MASTER_ADMIN_PASSWORD_2026

# Disable the public database manager and database selector (/web/database/manager).
# MUST be 'False' in production to prevent unauthorized database enumeration or deletion.
LIST_DB=False

# Strict regular expression to force Odoo to only serve the production database.
# Prevents multi-tenant leaks and speeds up request routing.
DB_FILTER=^obbs_dental_prod$

# ------------------------------------------------------------------------------
# 3. Network & Dokploy Configuration
# ------------------------------------------------------------------------------
# Optional domain reference (Note: Domains and SSL are configured directly
# in the Dokploy server dashboard under the "Domains" tab).
DOMAIN=clinic.example.com

# Name of the external Docker bridge network managed by Dokploy.
# Default in Dokploy is 'dokploy-network'.
DOKPLOY_NETWORK=dokploy-network

# Optional host port (only needed if gateway forwards traffic directly
# to the Dokploy server host port instead of routing through Dokploy reverse proxy).
ODOO_HOST_PORT=8069

# ------------------------------------------------------------------------------
# 4. Performance & Worker Concurrency Tuning
# ------------------------------------------------------------------------------
# Number of Odoo worker processes (multiprocessing mode).
# Formula: (CPU cores * 2) + 1. (e.g., 2 cores = 4-5 workers, 1 core = 2 workers).
# Set to 0 only for very low resource development. In production, 2+ is recommended.
ODOO_WORKERS=2

# Maximum concurrent cron workers (default: 1)
MAX_CRON_THREADS=1

# Maximum processing time limits in seconds
LIMIT_TIME_CPU=600
LIMIT_TIME_REAL=1200
