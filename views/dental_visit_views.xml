<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_visit_list" model="ir.ui.view">
        <field name="name">dental.visit.list</field>
        <field name="model">dental.visit</field>
        <field name="arch" type="xml">
            <list string="Dental Visits" multi_edit="1">
                <field name="patient_id"/>
                <field name="visit_date"/>
                <field name="dentist_id"/>
                <field name="service_ids" widget="many2many_tags"/>
                <field name="referred" widget="boolean_toggle"/>
                <field name="referral_reason" optional="show"/>
                <field name="counseling" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dental_visit_form" model="ir.ui.view">
        <field name="name">dental.visit.form</field>
        <field name="model">dental.visit</field>
        <field name="arch" type="xml">
            <form string="Dental Visit">
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id" invisible="context.get('default_patient_id')"/>
                            <field name="visit_date"/>
                            <field name="dentist_id"/>
                        </group>
                    </group>
                    <group string="Services Rendered">
                        <field name="service_ids" widget="many2many_tags"/>
                    </group>
                    <group string="DOH Reporting">
                        <group>
                            <field name="referred" widget="boolean_toggle"/>
                            <field name="referral_reason"/>
                            <field name="counseling" widget="boolean_toggle"/>
                            <field name="toothbrush_drill" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="ofc_oral_exam" widget="boolean_toggle"/>
                            <field name="ofc_rehabilitation" widget="boolean_toggle"/>
                            <field name="dentist_signature" widget="signature"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Visit notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dental_visit" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">dental.visit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
